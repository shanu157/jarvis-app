<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070D12"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/accessBackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="30sp"
            android:textColor="#8DE7F2"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/accessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCESS CENTER"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/accessSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="DEVICE PERMISSIONS"
                android:textColor="#6DADB8"
                android:textSize="11sp"
                android:letterSpacing="0.12" />

        </LinearLayout>

        <TextView
            android:id="@+id/accessOnline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● ONLINE"
            android:textColor="#6FE7B7"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="#18313A" />

    <TextView
        android:id="@+id/accessDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Choose which Android capabilities JARVIS can use. Android will ask for confirmation when required."
        android:textColor="#9CB1B9"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <ScrollView
        android:id="@+id/accessScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/accessContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/accessStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="#0D171E"
                android:textColor="#83DDE8"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/accessSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="DEVICE ACCESS"
                android:textColor="#668D97"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <Button
                android:id="@+id/accessMicrophone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Microphone"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/accessCamera"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Camera / Vision"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/accessPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Phone calls"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/accessSms"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="SMS"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/accessContacts"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Contacts"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/accessCalendar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Calendar"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/accessLocation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Location"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/accessNotifications"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Notifications"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/accessSystemTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="SYSTEM ACCESS"
                android:textColor="#668D97"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <Button
                android:id="@+id/accessExactAlarm"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Exact alarm settings"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/accessNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="14dp"
                android:text="JARVIS never bypasses Android permission controls. You can revoke access at any time from Android Settings."
                android:textColor="#718891"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/accessDoneButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="BACK TO JARVIS"
        android:textAllCaps="false"
        android:textStyle="bold" />

</LinearLayout>
