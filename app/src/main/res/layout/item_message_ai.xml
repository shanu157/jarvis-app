<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start"
    android:paddingStart="4dp"
    android:paddingEnd="48dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:id="@+id/aiBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="345dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="9dp"
        android:background="#0A111C">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/aiNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JARVIS"
                android:textColor="#00BCD4"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/aiStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="AI"
                android:textColor="#526176"
                android:textSize="9sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/aiMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Hello. How can I help you?"
            android:textColor="#DCE5F0"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/aiActionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#00AFC2"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/aiTools"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/copyButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Copy"
                android:textColor="#718198"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/regenerateButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Regenerate"
                android:textColor="#718198"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/aiTimeText"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:gravity="center_vertical|end"
                android:text="6:59 PM"
                android:textColor="#465368"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
