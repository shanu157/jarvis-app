<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <solid android:color="#173642" />

            <stroke
                android:width="1dp"
                android:color="#42D9FF" />

            <corners
                android:radius="18dp" />

            <padding
                android:left="14dp"
                android:top="8dp"
                android:right="14dp"
                android:bottom="8dp" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <solid android:color="#111D24" />

            <stroke
                android:width="1dp"
                android:color="#294651" />

            <corners
                android:radius="18dp" />

            <padding
                android:left="14dp"
                android:top="8dp"
                android:right="14dp"
                android:bottom="8dp" />

        </shape>
    </item>

</selector>
