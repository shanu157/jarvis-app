<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">

            <solid android:color="#263238" />

            <corners
                android:radius="20dp" />

        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <solid android:color="#2A91A8" />

            <stroke
                android:width="1dp"
                android:color="#72E8FF" />

            <corners
                android:radius="20dp" />

            <padding
                android:left="18dp"
                android:top="10dp"
                android:right="18dp"
                android:bottom="10dp" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <solid android:color="#176477" />

            <stroke
                android:width="1dp"
                android:color="#42D9FF" />

            <corners
                android:radius="20dp" />

            <padding
                android:left="18dp"
                android:top="10dp"
                android:right="18dp"
                android:bottom="10dp" />

        </shape>
    </item>

</selector>
